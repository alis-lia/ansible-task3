# {{ ansible_managed }}
[global]
   workgroup = {{ samba_workgroup }}
   server string = Servidor Samba ASO G8 (Ansible)
   security = user
   passdb backend = tdbsam
   map to guest = Bad User
   log file = /var/log/samba/log.%m
   max log size = 1000

[{{ samba_share_name }}]
   comment = Recurso compartido creado con Ansible
   path = {{ samba_share_path }}
   browseable = yes
   read only = no
   valid users = {{ samba_user }} @{{ samba_group }}
   force group = {{ samba_group }}
   create mask = {{ samba_create_mask }}
   directory mask = {{ samba_directory_mask }}
